[core]
	excludesFile = ~/.gitignore
[init]
	defaultBranch = main
[pull]
	ff = only
	rebase = true
[rebase]
	updateRefs = true
	autoSquash = true
	autoStash = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[user]
	name = Mark Steve Samson
	email = hello@marksteve.com
[push]
	default = simple
	autoSetupRemote = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[merge]
	tool = smerge
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
	tool = difftastic
[log]
	decorate = short
[alias]
	pull = pull --ff-only
	l = log --oneline --graph
	next = stack next
	prev = stack previous
	reword = stack reword
	amend = stack amend
	sync = stack sync
	run = stack run
[credential]
	helper = cache
	helper = /usr/local/share/gcm-core/git-credential-manager
[mergetool "smerge"]
	cmd = smerge mergetool \"$BASE\" \"$LOCAL\" \"$REMOTE\" -o \"$MERGED\"
	trustExitCode = true
[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[pager]
	difftool = true
[filter "media"]
	required = true
	clean = git media clean %f
	smudge = git media smudge %f
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process
